---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryNames = [...new Set(games.map((game) => game.category?.name).filter((name): name is string => Boolean(name)))].sort();
const publisherNames = [...new Set(games.map((game) => game.publisher?.name).filter((name): name is string => Boolean(name)))].sort();
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8" role="search">
      <label for="game-search-input" class="mb-2 block text-sm font-medium text-slate-200">Search games</label>
      <input
        id="game-search-input"
        type="search"
        autocomplete="off"
        placeholder="Search by title, genre, publisher, or keyword"
        class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/40"
        data-testid="game-search-input"
      />
      <p id="game-search-summary" class="mt-2 text-sm text-slate-300" aria-live="polite" hidden data-testid="game-search-summary"></p>
    </div>

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-5" data-testid="game-filters">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
        <h2 class="text-lg font-medium text-slate-100">Filter games</h2>
        <div>
          <label for="game-sort" class="mr-2 text-sm font-medium text-slate-200">Sort games</label>
          <select
            id="game-sort"
            class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/40"
            data-testid="game-sort"
          >
            <option value="title-asc">Title: A-Z</option>
            <option value="title-desc">Title: Z-A</option>
            <option value="rating-desc">Rating: highest first</option>
          </select>
        </div>
      </div>
      <div class="grid gap-5 md:grid-cols-[2fr_1fr]">
        <fieldset>
          <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
          <div class="flex flex-wrap gap-3">
            {categoryNames.map((category) => (
              <label class="flex items-center gap-2 text-sm text-slate-300">
                <input
                  type="checkbox"
                  value={category}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-testid={`category-filter-${category}`}
                />
                {category}
              </label>
            ))}
          </div>
        </fieldset>
        <div>
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/40"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publisherNames.map((publisher) => <option value={publisher}>{publisher}</option>)}
          </select>
        </div>
      </div>
      <p id="game-filter-summary" class="mt-3 text-sm text-slate-300" aria-live="polite" data-testid="game-filter-summary"></p>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div id="game-search-empty-state" data-testid="game-search-empty-state" role="status" aria-live="polite" hidden>
            <EmptyState text="No games match your search. Try a different title, genre, or publisher." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('game-search-input') as HTMLInputElement | null;
  const searchSummary = document.getElementById('game-search-summary') as HTMLParagraphElement | null;
  const emptyState = document.getElementById('game-search-empty-state') as HTMLElement | null;
  const filterSummary = document.getElementById('game-filter-summary') as HTMLParagraphElement | null;
  const publisherFilter = document.getElementById('publisher-filter') as HTMLSelectElement | null;
  const sortSelect = document.getElementById('game-sort') as HTMLSelectElement | null;
  const categoryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid^="category-filter-"]'));
  const cardsContainer = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const cards = cardsContainer ? Array.from(cardsContainer.querySelectorAll<HTMLElement>('[data-testid="game-card"]')) : [];

  function normalizeSearchText(value: string): string {
    return String(value ?? '')
      .toLocaleLowerCase()
      .replace(/[^a-z0-9\s]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function hasFuzzySubsequence(query: string, value: string): boolean {
    if (!query.length) return true;
    if (query.length > value.length) return false;

    let queryIndex = 0;
    for (const character of value) {
      if (character === query[queryIndex]) {
        queryIndex += 1;
        if (queryIndex === query.length) {
          return true;
        }
      }
    }

    return false;
  }

  function matchesQuery(query: string, value: string): boolean {
    const normalizedQuery = normalizeSearchText(query);
    const normalizedValue = normalizeSearchText(value);

    if (!normalizedQuery) {
      return true;
    }

    if (normalizedValue.includes(normalizedQuery)) {
      return true;
    }

    const queryTokens = normalizedQuery.split(/\s+/).filter(Boolean);
    const valueTokens = normalizedValue.split(/\s+/).filter(Boolean);

    if (queryTokens.length === 0) {
      return true;
    }

    if (queryTokens.every((token) => valueTokens.some((valueToken) => valueToken.includes(token)))) {
      return true;
    }

    return queryTokens.every((token) => valueTokens.some((valueToken) => hasFuzzySubsequence(token, valueToken)));
  }

  function updateGameList() {
    const query = searchInput ? searchInput.value : '';
    const selectedCategories = categoryFilters.filter((filter) => filter.checked).map((filter) => filter.value);
    const selectedPublisher = publisherFilter?.value ?? '';
    const sort = sortSelect?.value ?? 'title-asc';
    let visibleCount = 0;

    const sortedCards = [...cards].sort((left, right) => {
      if (sort === 'rating-desc') {
        const leftRating = left.dataset.gameRating ? Number(left.dataset.gameRating) : null;
        const rightRating = right.dataset.gameRating ? Number(right.dataset.gameRating) : null;
        if (leftRating === null && rightRating !== null) return 1;
        if (leftRating !== null && rightRating === null) return -1;
        if (leftRating !== rightRating) return (rightRating ?? 0) - (leftRating ?? 0);
      }
      const titleOrder = (left.dataset.gameTitle ?? '').localeCompare(right.dataset.gameTitle ?? '');
      return sort === 'title-desc' ? -titleOrder : titleOrder;
    });

    sortedCards.forEach((card) => cardsContainer?.appendChild(card));

    sortedCards.forEach((card) => {
      const matchesSearch = matchesQuery(query, card.getAttribute('data-search-text') ?? '');
      const category = card.getAttribute('data-game-category') ?? '';
      const publisher = card.getAttribute('data-game-publisher') ?? '';
      const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(category);
      const matchesPublisher = !selectedPublisher || selectedPublisher === publisher;
      const matches = matchesSearch && matchesCategory && matchesPublisher;
      const shouldDisplay = matches;
      card.hidden = !shouldDisplay;
      if (shouldDisplay) {
        visibleCount += 1;
      }
    });

    if (searchSummary) {
      if (!query.trim()) {
        searchSummary.hidden = true;
        searchSummary.textContent = '';
      } else {
        searchSummary.hidden = false;
        searchSummary.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'} match your search.`;
      }
    }

    if (emptyState) {
      emptyState.hidden = visibleCount > 0 || (!query.trim() && selectedCategories.length === 0 && !selectedPublisher);
    }

    if (filterSummary) {
      const activeFilters = selectedCategories.length + (selectedPublisher ? 1 : 0);
      filterSummary.textContent = activeFilters
        ? `${visibleCount} game${visibleCount === 1 ? '' : 's'} match${visibleCount === 1 ? 'es' : ''} the selected filters.`
        : '';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', updateGameList);
  }
  categoryFilters.forEach((filter) => filter.addEventListener('change', updateGameList));
  publisherFilter?.addEventListener('change', updateGameList);
  sortSelect?.addEventListener('change', updateGameList);
  updateGameList();
</script>
